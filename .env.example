# Local development only. Never commit real secrets.
# Copy to workers/platform/.dev.vars for Wrangler.

APP_ENV=development
APP_ORIGIN=http://localhost:8787
WEBAUTHN_RP_ID=localhost
SESSION_SECRET=replace-with-long-random-string
# Local login secret. Required for /api/auth/dev-login, and only honored on loopback.
DEV_LOGIN_SECRET=replace-with-another-long-random-string
ENABLE_PATCH_PR=false
ENABLE_PROJECT_DOMAINS=false
ENABLE_BROWSER_RUN=false
ENABLE_WORKERS_AI=false

# Optional. Required to call the local maintenance routes.
# MAINTENANCE_SECRET=

# Provisioned later — leave unset for honest not-configured states
# GITHUB_APP_ID=
# GITHUB_WEBHOOK_SECRET=
